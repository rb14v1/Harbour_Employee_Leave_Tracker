# Copy to .env and fill in real values before running docker compose.

# --- Django ---
# Required. No default: supply your own long random string.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database (PostgreSQL) ---
POSTGRES_DB=leave_tracker
POSTGRES_USER=postgres
# Required. No default.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Initial administrator ---
# Created on container start by: python manage.py create_admin
# Username and email default to admin / admin@example.com when left empty.
# No default password: leave DJANGO_ADMIN_PASSWORD empty to skip admin creation.
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=

# --- Demo mode ---
# 1 opens the app without a sign-in page. Anyone who can reach the app gets full admin access.
# Use only for a private demo.
DEMO_AUTO_LOGIN=1

# --- Frontend ---
FRONTEND_PORT=8080
