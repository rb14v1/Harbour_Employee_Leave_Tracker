# Docker Compose variables (copy to .env at repo root)
POSTGRES_DB=leave_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Initial administrator, created on container start by: python manage.py create_admin
# Username and email default to admin / admin@example.com.
# There is no default password: leave it empty to skip admin creation, or set your own.
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=

# Demo mode: 1 opens the app without a sign-in page (the app has none).
# Anyone who can reach the app gets full admin access. Keep it to a private demo.
DEMO_AUTO_LOGIN=1

FRONTEND_PORT=8080
