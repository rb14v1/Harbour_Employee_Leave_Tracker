# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=leave_tracker
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Demo mode: when 1, the app signs in automatically as the demo admin.
# Gives anyone who can reach the app full admin access. Keep 0 unless the app is a private demo.
DEMO_AUTO_LOGIN=0
DEMO_ADMIN_USERNAME=demo

# Initial administrator (used by: python manage.py create_admin)
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=change-me-admin-password
