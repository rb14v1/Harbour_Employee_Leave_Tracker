# Generated from what this app's own code reads at start-up.
# Django does not load this file itself: export these variables in your shell,
# or pass them through docker compose (root .env).
# Values left empty must be filled in before running.

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_NAME=leave_tracker
# Required. No default.
DB_PASSWORD=
DB_PORT=5432
DB_USER=postgres

# --- Demo mode ---
# 1 signs in automatically as the demo admin. Anyone who can reach the app gets full admin access.
DEMO_ADMIN_USERNAME=demo
DEMO_AUTO_LOGIN=0

# --- Initial administrator (python manage.py create_admin) ---
# Username and email default to admin / admin@example.com when empty.
# Leave DJANGO_ADMIN_PASSWORD empty to skip admin creation.
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_USERNAME=admin

# --- Django ---
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required. No default in production.
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.dev
