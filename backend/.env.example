# Environment variables this app reads at start-up. Copy to backend/.env and adjust.
# Django loads backend/.env itself; real environment variables take precedence.
# Secrets are left empty on purpose and have no default: DB_PASSWORD,
# DJANGO_SECRET_KEY, DJANGO_ADMIN_PASSWORD, POSTGRES_PASSWORD.

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_NAME=leave_tracker
DB_PASSWORD=
DB_PORT=5432
DB_USER=postgres

# --- Demo mode: 1 signs in automatically as the demo admin (private demos only) ---
DEMO_ADMIN_USERNAME=demo
DEMO_AUTO_LOGIN=0

# --- Initial administrator (python manage.py create_admin) ---
# Leave DJANGO_ADMIN_PASSWORD empty to skip admin creation.
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_USERNAME=admin

# --- Django ---
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=False
# Required: a long random string.
DJANGO_SECRET_KEY=

# --- JWT lifetimes ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# --- Health check (healthz.py) ---
HEALTHCHECK_TIMEOUT_SECONDS=3
HEALTHCHECK_URL=http://127.0.0.1:8000/api/health/

# --- Docker Compose (root .env) ---
FRONTEND_PORT=8080
POSTGRES_DB=leave_tracker
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_USER=postgres
