# Names of the environment variables this app reads at start-up.
# Values are deliberately empty: fill in the ones your environment must supply.
# Empty values fall back to the defaults in the code, except the secrets
# (DB_PASSWORD, DJANGO_SECRET_KEY, DJANGO_ADMIN_PASSWORD), which have no default.

DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=
DB_USER=
DEMO_ADMIN_USERNAME=
DEMO_AUTO_LOGIN=
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_USERNAME=
DJANGO_ALLOWED_HOSTS=
DJANGO_DEBUG=
DJANGO_SECRET_KEY=
FRONTEND_PORT=
HEALTHCHECK_TIMEOUT_SECONDS=
HEALTHCHECK_URL=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=
JWT_REFRESH_TOKEN_LIFETIME_DAYS=
POSTGRES_DB=
POSTGRES_PASSWORD=
POSTGRES_PORT=
POSTGRES_USER=
