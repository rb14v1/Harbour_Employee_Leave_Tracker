# Generated from what this app's own code reads at start-up.
# Vite reads these at build or dev-server start. Restart the dev server after changing them.

# API base path. Must stay /api. Do not leave it empty: an empty value turns every request into /employees/ etc.
VITE_API_BASE_URL=/api

# Dev only: backend origin used by the Vite proxy (vite.config.ts). Not used in the production build.
VITE_BACKEND_URL=http://127.0.0.1:8000
