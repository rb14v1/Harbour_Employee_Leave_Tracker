# Environment variables the frontend reads at build or dev-server start.
# Copy to frontend/.env and adjust. Restart the dev server after changing them.

# API base path. Keep /api so requests go through the Vite dev proxy or nginx.
VITE_API_BASE_URL=/api

# Dev only: backend origin used by the Vite proxy. Not used in the production build.
VITE_BACKEND_URL=http://127.0.0.1:8000
